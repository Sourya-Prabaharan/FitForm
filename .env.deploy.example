# Copy to .env.deploy on a server. Never commit real values.
FITFORM_DOMAIN=api.your-domain.com
POSTGRES_PASSWORD=replace-with-random-hex-secret
JWT_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your-smtp-login
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=FitForm <support@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com
MAX_UPLOAD_MB=250
MAX_VIDEO_SECONDS=120
