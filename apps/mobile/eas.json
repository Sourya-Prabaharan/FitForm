{
  "cli": {
    "version": ">= 19.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "resourceClass": "m-medium" }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "ios": { "resourceClass": "m-medium", "image": "macos-sequoia-15.6-xcode-26.2" }
    }
  },
  "submit": {
    "production": {
      "ios": {
      }
    }
  }
}
