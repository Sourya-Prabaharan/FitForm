ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fitform:fitform@postgres:5432/fitform
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=["http://localhost:19006","http://localhost:8081"]
AWS_REGION=us-east-1
S3_BUCKET=fitform-videos-dev
S3_ENDPOINT_URL=
# Cloudflare R2 example:
# AWS_REGION=auto
# S3_BUCKET=fitform-videos-dev
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
LOCAL_STORAGE_PATH=/tmp/fitform-videos
TRUSTED_HOSTS=["localhost","127.0.0.1","api.fitform.example.com"]
MAX_UPLOAD_MB=250
