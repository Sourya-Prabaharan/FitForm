ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://fitform:REPLACE_ME@fitform-prod.cluster.example.com:5432/fitform?sslmode=require
REDIS_URL=rediss://:REPLACE_ME@fitform-prod-redis.example.com:6379/0
JWT_SECRET=replace-with-64-plus-character-random-production-secret
CORS_ORIGINS=["https://fitform.example.com"]
TRUSTED_HOSTS=["api.fitform.example.com"]
AWS_REGION=auto
S3_BUCKET=fitform-videos-prod
S3_ENDPOINT_URL=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
LOCAL_STORAGE_PATH=/tmp/fitform-videos
MAX_UPLOAD_MB=250
# Required for real password reset delivery:
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_STARTTLS=true
SUPPORT_EMAIL=support@your-domain.com
SMTP_USERNAME=replace-with-smtp-login
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=FitForm <support@your-domain.com>
